rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    function texto(valor, max) {
      return valor is string && valor.size() <= max;
    }

    function leadValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nome', 'whatsapp', 'tipo', 'modelo', 'observacao',
          'origem', 'status', 'respostas', 'createdAt'
        ])
        && texto(d.nome, 120) && d.nome.size() > 0
        && texto(d.whatsapp, 20) && d.whatsapp.size() >= 10
        && d.tipo in ['FINANCIAMENTO', 'CONSÓRCIO', 'CONHECER MOTOS']
        && texto(d.modelo, 80)
        && texto(d.observacao, 500)
        && d.origem in ['trafego-pago', 'formulario']
        && d.status == 'novo'
        && d.respostas is map
        && d.createdAt is timestamp;
    }

    function soStatus() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['novo', 'em_atendimento', 'visita', 'ganho', 'perdido'];
    }

    match /leads/{leadId} {
      allow read: if logado();
      allow create: if logado() && leadValido();
      allow update: if logado() && soStatus();
      allow delete: if false;
    }
  }
}
